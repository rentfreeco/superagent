# Copy to apps/agent/.env (git-ignored). CONTRIBUTING.md has where each value comes from.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_OWNER_ID=
# debug, info, warn or error. debug also logs every event the gate drops.
LOG_LEVEL=info
# Where the store (state.db) and the task worktrees live. Unset means ~/.superagent.
# Not inside a .claude directory: Claude Code refuses workers' file edits there.
# SUPERAGENT_DATA_DIR=/data
# Claude Code's credentials for the task workers. Unset uses this machine's claude login.
# ANTHROPIC_API_KEY=
# on runs workers' shell commands in Claude Code's sandbox: writes limited to the
# worktree, its checkout's .git, and $SUPERAGENT_DATA_DIR/cache for package
# managers; network to GitHub and package registries. On macOS, gh can't verify
# TLS inside it (Go asks a system service the sandbox blocks), so workers can't
# open pull requests there yet: see the roadmap's open decision 2.
# SUPERAGENT_WORKER_SANDBOX=off
# off lets the channel map decide every new message, without a router session.
# SUPERAGENT_ROUTER=on
# superagent's own GitHub account: workers push, open pull requests, and comment as it,
# never as you. A token for that account (repo access to each configured repo), and your
# own GitHub login, so superagent can tell your comments from its own. Unset, workers use
# this machine's GitHub logins.
# SUPERAGENT_GITHUB_TOKEN=
# SUPERAGENT_OWNER_GITHUB=
