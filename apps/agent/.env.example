# Copy to apps/agent/.env (git-ignored). CONTRIBUTING.md has where each value comes from.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_OWNER_ID=
# debug, info, warn or error. debug also logs every event the gate drops.
LOG_LEVEL=info
# Where the store (state.db) lives. Unset means ~/.superagent; Docker uses /data.
# SUPERAGENT_DATA_DIR=/data
