{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SLACK_BOT_TOKEN",
        "SLACK_APP_TOKEN",
        "SLACK_OWNER_ID",
        "LOG_LEVEL",
        "SUPERAGENT_DATA_DIR",
        "SUPERAGENT_WORKER_SANDBOX",
        "SUPERAGENT_ROUTER",
        "SUPERAGENT_GITHUB_TOKEN",
        "SUPERAGENT_OWNER_GITHUB",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "SSH_AUTH_SOCK"
      ]
    }
  }
}
